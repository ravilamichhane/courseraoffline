# Mode: "development" proxies frontend requests to http://127.0.0.1:3000;
# omit or set to "production" to serve the embedded/built frontend/dist folder.
MODE=development

# Required API key for authenticating on the frontend
API_KEY=dev

# Optional: data folder path (defaults to ./data in the current working directory)
# DATA_DIR=./data

# Optional: host and port for the server (defaults to 0.0.0.0:8080)
# HOST=0.0.0.0
# PORT=8080
